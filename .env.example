# AI Token Vault — environment variables
# Copy jadi .env.local buat dev, atau isi lewat cPanel > Setup Node.js App > Environment.
# JANGAN pernah commit file ini.

# --- Database (cPanel > MySQL/MariaDB Databases) ---
# Host biasanya 'localhost' di shared hosting cPanel.
DB_HOST=localhost
DB_PORT=3306
DB_USER=limunweb_cpuser
DB_PASSWORD=
DB_NAME=limunweb_cpuser_aitokenvault

# --- Enkripsi token API (AES-256-GCM) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 karakter hex. Kalau diganti, semua token lama gak bisa didekripsi.
TOKEN_ENCRYPTION_KEY=

# --- Opsional ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Isi '1' HANYA saat menjalankan test suite (E2E), jangan di production.
# DISABLE_RATE_LIMIT=1
